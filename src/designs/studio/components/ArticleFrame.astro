---
import type { Profile } from '../../../core/content';
import PageFrame from './PageFrame.astro';
import Icon from './Icon.astro';
interface Props {
  profile: Profile;
  title: string;
  summary: string;
  headings: { depth: number; slug: string; text: string }[];
  backHref: string;
  backLabel: string;
  wideHeader?: boolean;
}
const { profile, title, summary, headings, backHref, backLabel, wideHeader = false } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<PageFrame profile={profile}>
  <div class="article-top">
    <a class="text-link muted" href={backHref}>
      <Icon name="arrow-left" size={14} />
      {backLabel}
    </a>
  </div>
  {wideHeader && (
    <header class="article-heading article-heading-wide">
      <div class="eyebrow">
        <slot name="meta" />
      </div>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p data-pagefind-meta="description">{summary}</p>
      <div class="article-tags">
        <slot name="tags" />
      </div>
      <slot name="intro" />
    </header>
  )}
  <slot name="wide" />
  <div class="article-grid">
    <article>
      {!wideHeader && (
        <header class="article-heading">
          <div class="eyebrow">
            <slot name="meta" />
          </div>
          <h1 data-pagefind-meta="title">{title}</h1>
          <p data-pagefind-meta="description">{summary}</p>
          <div class="article-tags">
            <slot name="tags" />
          </div>
        </header>
      )}
      {tocHeadings.length > 0 && (
        <details class="toc-inline" data-toc-inline data-pagefind-ignore>
          <summary class="eyebrow">ON THIS PAGE</summary>
          <nav aria-label="목차">
            {tocHeadings.map((h) => (
              <a href={`#${h.slug}`} class:list={{ sub: h.depth === 3 }}>
                {h.text}
              </a>
            ))}
          </nav>
        </details>
      )}
      <slot />
      <div class="article-end">
        <span class="accent">✳</span>
        <p class="mono muted">THANKS FOR READING</p>
        <button class="filter-chip" data-copy-url>
          <span data-copy-label>링크 복사</span>
          <Icon name="copy" size={14} />
          <Icon name="check" size={14} play />
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>
      <slot name="after" />
    </article>
    <aside class="toc" aria-label="목차">
      <p class="eyebrow">ON THIS PAGE</p>
      <nav data-toc>
        {tocHeadings.map((h) => (
          <a href={`#${h.slug}`} class:list={{ sub: h.depth === 3 }}>
            {h.text}
          </a>
        ))}
      </nav>
      <div class="toc-extra">
        <slot name="aside" />
      </div>
    </aside>
  </div>
</PageFrame>
<script>
  document.querySelector('[data-copy-url]')?.addEventListener('click', async () => {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-url]')!;
    const status = document.querySelector('[data-copy-status]')!;
    const label = button.querySelector('[data-copy-label]')!;
    try {
      await navigator.clipboard.writeText(location.href);
      label.textContent = '복사 완료';
      button.dataset.copied = 'true';
      status.textContent = '글 주소를 복사했습니다.';
    } catch {
      status.textContent = `주소창에서 링크를 복사해 주세요. ${location.href}`;
      label.textContent = '주소창에서 복사해 주세요';
    }
  });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const tocTargets = tocLinks.map((link) =>
    document.getElementById(decodeURIComponent(link.hash.slice(1))),
  );
  if (tocLinks.length) {
    let queued = false;
    const markCurrent = () => {
      queued = false;
      let current = -1;
      tocTargets.forEach((target, index) => {
        // 화면에 그려지지 않는 대상(숨겨진 정적 대체 콘텐츠)은 건너뛴다.
        if (!target || target.getClientRects().length === 0) return;
        if (target.getBoundingClientRect().top <= 140) current = index;
      });
      tocLinks.forEach((link, index) => {
        if (index === current) {
          if (link.getAttribute('aria-current') === 'location') return;
          link.setAttribute('aria-current', 'location');
          link.scrollIntoView({ block: 'nearest' });
        } else link.removeAttribute('aria-current');
      });
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(markCurrent);
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    markCurrent();
  }
  const inlineToc = document.querySelector<HTMLDetailsElement>('[data-toc-inline]');
  inlineToc?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) inlineToc.open = false;
  });
</script>
<style>
  .article-top {
    padding: 40px 0 24px;
  }
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(150px, 220px);
    justify-content: space-between;
    gap: 70px;
  }
  .article-heading {
    padding: 20px 0 32px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  .article-heading-wide {
    max-width: 760px;
    margin-bottom: 0;
    border-bottom: 0;
  }
  .article-heading h1 {
    font-size: clamp(30px, 4vw, 44px);
    margin: 18px 0;
    line-height: 1.45;
  }
  .article-heading > p {
    color: var(--muted);
    font-size: 15px;
  }
  .article-tags {
    margin-top: 22px;
  }
  .article-end {
    margin: 50px 0 30px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .article-end > span:first-child {
    font-size: 30px;
  }
  .article-end p {
    font-size: 10px;
  }
  .article-end button {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .article-end button :global(.icon-check),
  .article-end button[data-copied='true'] :global(.icon-copy) {
    display: none;
  }
  .article-end button[data-copied='true'] :global(.icon-check) {
    display: block;
    color: var(--accent);
  }
  .toc {
    position: sticky;
    top: 35px;
    align-self: start;
    padding-top: 24px;
  }
  .toc > p {
    margin-bottom: 12px;
    font-size: 10px;
  }
  .toc nav,
  .toc-inline nav {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }
  .toc nav {
    max-height: calc(100vh - 220px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .toc a,
  .toc-inline a {
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.5;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .toc a:hover,
  .toc a:focus-visible,
  .toc-inline a:hover,
  .toc-inline a:focus-visible {
    color: var(--accent);
  }
  .toc a[aria-current='location'] {
    color: var(--ink);
    border-left-color: var(--accent);
  }
  .toc a:focus-visible,
  .toc-inline a:focus-visible {
    outline-offset: -2px;
  }
  .toc a.sub,
  .toc-inline a.sub {
    padding-left: 26px;
    font-size: 11px;
  }
  .toc-inline {
    display: none;
    margin-bottom: 30px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .toc-inline summary {
    cursor: pointer;
  }
  .toc-inline nav {
    margin-top: 12px;
  }
  .toc-inline a {
    font-size: 13px;
    padding-block: 7px;
  }
  .toc-extra {
    padding-top: 25px;
  }
  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      display: none;
    }
    .toc-inline {
      display: block;
    }
  }
</style>
