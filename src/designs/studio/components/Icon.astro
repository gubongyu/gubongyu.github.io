---
/*
 * Animated icons, ported to inline SVG + CSS.
 *
 * Shapes and hover animations are adapted from AnimateIcons
 * (https://github.com/Avijit07x/animateicons), where they ship as React + motion
 * components. The motion variants are re-expressed below as CSS keyframes.
 *
 *   AnimateIcons — MIT License, Copyright (c) 2025 Avijit Dey
 *   Icon shapes: Lucide (https://github.com/lucide-icons/lucide) — ISC License,
 *     Copyright (c) Lucide Icons and Contributors. Some Lucide icons derive from
 *     Feather — MIT License, Copyright (c) 2013-present Cole Bemis.
 *
 * Permission to use, copy, modify, and/or distribute this software for any purpose
 * with or without fee is hereby granted, provided that the above copyright notices
 * and this permission notice appear in all copies. THE SOFTWARE IS PROVIDED "AS IS",
 * WITHOUT WARRANTY OF ANY KIND.
 *
 * Icons are decorative: the accessible name stays on the surrounding link or button.
 * The animation plays while the nearest link, button or [data-icon-trigger] ancestor
 * is hovered or keyboard-focused. `play` runs it once when the icon appears instead.
 */
const icons = {
  'arrow-up-right': '<g class="i i-ne"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></g>',
  'arrow-down-right': '<g class="i i-se"><path d="m7 7 10 10"/><path d="M17 7v10H7"/></g>',
  'arrow-left': '<g class="i i-w"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></g>',
  'arrow-down': '<g class="i i-s"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></g>',
  'external-link':
    '<g class="i i-out"><path d="M15 3h6v6"/><path d="M10 14 21 3"/></g><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  search: '<g class="i i-lens"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.34-4.34"/></g>',
  sun: '<g class="i i-sun"><circle class="i i-sun-core" cx="12" cy="12" r="4"/><g class="i i-sun-rays"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></g></g>',
  moon: '<path class="i i-moon" d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path class="i i-tail" d="M9 18c-4.51 2-5-2-7-2"/>',
  mail: '<path class="i i-flap" d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
  rss: '<circle class="i i-rss-dot" cx="5" cy="19" r="1"/><path class="i i-rss-near" d="M4 11a9 9 0 0 1 9 9"/><path class="i i-rss-far" d="M4 4a16 16 0 0 1 16 16"/>',
  copy: '<rect class="i i-copy-front" width="14" height="14" x="8" y="8" rx="2" ry="2"/><path class="i i-copy-back" d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  check: '<path class="i i-tick" d="M5 13l4 4L19 7" stroke-dasharray="20" stroke-dashoffset="0"/>',
} as const;
export type IconName = keyof typeof icons;
interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  play?: boolean;
  class?: string;
  [scope: `data-${string}`]: unknown;
}
const { name, size = 16, stroke = 1.75, play = false, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['icon', `icon-${name}`, { 'icon-play': play }, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={icons[name]}
/>
<style is:global>
  .icon {
    flex: none;
    overflow: visible;
  }
  .icon .i {
    transform-box: view-box;
    transform-origin: 12px 12px;
    animation-duration: 0.6s;
    animation-timing-function: ease-in-out;
  }
  .icon .i-ne {
    --icon-animation: icon-nudge-ne;
  }
  .icon .i-se {
    --icon-animation: icon-nudge-se;
  }
  .icon .i-w {
    --icon-animation: icon-nudge-w;
  }
  .icon .i-s {
    --icon-animation: icon-nudge-s;
  }
  .icon .i-out {
    --icon-animation: icon-out;
  }
  .icon .i-lens {
    --icon-animation: icon-lens;
    transform-box: fill-box;
    transform-origin: center;
    animation-duration: 1s;
  }
  .icon .i-sun {
    --icon-animation: icon-sun-turn;
    animation-duration: 0.8s;
  }
  .icon .i-sun-core {
    --icon-animation: icon-sun-core;
    animation-duration: 0.8s;
  }
  .icon .i-sun-rays {
    --icon-animation: icon-sun-rays;
    animation-duration: 0.8s;
  }
  .icon .i-moon {
    --icon-animation: icon-moon;
    animation-duration: 0.8s;
  }
  .icon .i-tail {
    --icon-animation: icon-tail;
    transform-origin: 9px 18px;
    animation-duration: 0.8s;
  }
  .icon .i-flap {
    --icon-animation: icon-flap;
    transform-origin: 12px 7px;
    animation-duration: 0.8s;
  }
  .icon .i-rss-dot {
    --icon-animation: icon-rss-dot;
    transform-origin: 5px 19px;
    animation-duration: 0.5s;
  }
  .icon .i-rss-near {
    --icon-animation: icon-rss-near;
    transform-origin: 4px 20px;
    animation-delay: 0.1s;
  }
  .icon .i-rss-far {
    --icon-animation: icon-rss-far;
    transform-origin: 4px 20px;
    animation-delay: 0.22s;
  }
  .icon .i-copy-front {
    --icon-animation: icon-copy-front;
    animation-duration: 0.9s;
  }
  .icon .i-copy-back {
    --icon-animation: icon-copy-back;
    animation-duration: 0.9s;
  }
  .icon .i-tick {
    --icon-animation: icon-tick-draw, icon-tick-pop;
    animation-duration: 0.5s, 0.55s;
    animation-timing-function: ease-out, ease-in-out;
  }
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='off'])
      :is(a, button, [data-icon-trigger]):is(:hover, :focus-visible)
      .icon
      .i,
    :root:not([data-motion='off']) [data-icon-trigger]:focus-within .icon .i,
    :root:not([data-motion='off']) .icon-play .i {
      animation-name: var(--icon-animation);
    }
  }
  @keyframes icon-nudge-ne {
    20% {
      transform: translate(-1.5px, 1.5px);
    }
    60% {
      transform: translate(3px, -3px);
    }
  }
  @keyframes icon-nudge-se {
    20% {
      transform: translate(-1.5px, -1.5px);
    }
    60% {
      transform: translate(3px, 3px);
    }
  }
  @keyframes icon-nudge-w {
    20% {
      transform: translateX(2px);
    }
    60% {
      transform: translateX(-4px);
    }
  }
  @keyframes icon-nudge-s {
    20% {
      transform: translateY(-2px);
    }
    60% {
      transform: translateY(4px);
    }
  }
  @keyframes icon-out {
    40% {
      transform: translate(1.5px, -1.5px);
    }
    75% {
      transform: translate(-0.4px, 0.4px);
    }
  }
  @keyframes icon-lens {
    25% {
      transform: translate(2px, -1px) rotate(6deg);
    }
    50% {
      transform: translate(-2px, 2px) rotate(-6deg);
    }
    75% {
      transform: translate(1px, -1px) rotate(4deg);
    }
  }
  @keyframes icon-sun-turn {
    40% {
      transform: rotate(14deg);
    }
    75% {
      transform: rotate(-6deg);
    }
  }
  @keyframes icon-sun-core {
    50% {
      transform: scale(1.18);
    }
  }
  @keyframes icon-sun-rays {
    50% {
      opacity: 0.7;
    }
  }
  @keyframes icon-moon {
    25% {
      transform: rotate(-16deg);
    }
    50% {
      transform: rotate(12deg);
    }
    75% {
      transform: rotate(-6deg);
    }
  }
  @keyframes icon-tail {
    25% {
      transform: rotate(-18deg);
    }
    50% {
      transform: rotate(14deg);
    }
    75% {
      transform: rotate(-7deg);
    }
  }
  @keyframes icon-flap {
    40%,
    65% {
      transform: scaleY(-0.8);
    }
  }
  @keyframes icon-rss-dot {
    50% {
      transform: scale(1.6);
    }
  }
  @keyframes icon-rss-near {
    35% {
      transform: scale(1.15);
    }
    70% {
      transform: scale(0.97);
    }
  }
  @keyframes icon-rss-far {
    35% {
      transform: scale(1.07);
    }
    70% {
      transform: scale(0.97);
    }
  }
  @keyframes icon-copy-front {
    50% {
      transform: translate(-3px, -3px);
    }
  }
  @keyframes icon-copy-back {
    50% {
      transform: translate(3px, 3px);
    }
  }
  @keyframes icon-tick-draw {
    from {
      stroke-dashoffset: 20;
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes icon-tick-pop {
    from {
      transform: scale(0.9);
    }
    60% {
      transform: scale(1.12);
    }
  }
</style>
