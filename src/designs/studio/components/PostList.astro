---
import type { PostVM } from '../../../application/contracts';
import Icon from './Icon.astro';
interface Props {
  posts: PostVM[];
  numbered?: boolean;
}
const { posts, numbered = false } = Astro.props;
---

<div class="posts" data-reveal-group>
  {posts.map((post, index) => (
    <article
      class="post-row"
      data-filter-item
      data-icon-trigger
      data-section={post.section}
      data-tags={JSON.stringify(post.tags)}
      data-search-text={`${post.title} ${post.summary} ${post.tags.join(' ')}`}
    >
      {numbered && <span class="post-number mono">{String(index + 1).padStart(2, '0')}</span>}
      <a href={post.href} class="post-main">
        <div class="post-meta">
          <span class:list={['post-category', { dev: post.section === 'dev' }]}>
            {post.sectionLabel}
          </span>
          <time datetime={post.publishedAt}>{post.dateLabel}</time>
          <span>· {post.readingMinutes} min read</span>
          {post.sample && <span class="sample-label">예제</span>}
        </div>
        <h3>{post.title}</h3>
        <p>{post.summary}</p>
      </a>
      <a class="post-arrow" href={post.href} aria-label={`${post.title} 읽기`}>
        <Icon name="arrow-up-right" size={20} stroke={1.5} />
      </a>
    </article>
  ))}
</div>
<style>
  .post-row {
    padding: 27px 0;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post-main {
    flex: 1;
    min-width: 0;
    transition: transform var(--dur) var(--ease);
  }
  .post-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    font: 10px/1.6 var(--mono);
    color: var(--muted);
    margin-bottom: 9px;
  }
  .post-category {
    font: 10px/1.5 var(--sans);
    color: var(--muted);
  }
  .post-category.dev {
    color: var(--accent);
  }
  h3 {
    font-size: 20px;
    transition: color var(--dur-fast) var(--ease);
  }
  p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 8px;
    max-width: 700px;
  }
  .post-row:hover h3,
  .post-row:focus-within h3 {
    color: var(--accent);
  }
  .post-arrow {
    flex: 0 0 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .post-row:hover .post-arrow,
  .post-row:focus-within .post-arrow {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .post-row:hover .post-main,
    :global(:root:not([data-motion='off'])) .post-row:focus-within .post-main {
      transform: translateX(6px);
    }
  }
  .post-number {
    color: var(--muted);
    font-size: 11px;
  }
  @media (max-width: 600px) {
    .post-row {
      gap: 12px;
      padding: 23px 0;
    }
    h3 {
      font-size: 18px;
    }
    .post-number {
      display: none;
    }
    p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .post-arrow {
      flex-basis: 28px;
    }
  }
</style>
