---
import type { ProjectVM } from '../../../application/contracts';
import { path } from '../../../config/site';
import Icon from './Icon.astro';
interface Props {
  project: ProjectVM;
  index?: number;
}
const { project, index = 0 } = Astro.props;
---

<article
  class="project-card"
  data-filter-item
  data-tags={JSON.stringify(project.stack)}
  data-search-text={`${project.title} ${project.summary} ${project.stack.join(' ')}`}
>
  <a
    class:list={['project-art', { alternate: index % 2 === 1 }]}
    href={project.href}
    aria-label={`${project.title} 자세히 보기`}
  >
    {project.cover && project.coverAlt ? (
      <img
        class="project-cover"
        src={path(project.cover.slice(1))}
        alt={project.coverAlt}
        loading="lazy"
      />
    ) : (
      <>
        <div class="art-grid" aria-hidden="true"></div>
        <span class="art-label mono">EXPERIMENT {String(index + 1).padStart(2, '0')}</span>
        <span class="art-expand">
          <Icon name="arrow-up-right" size={20} stroke={1.5} />
        </span>
        {index % 2 === 0 ? (
          <div class="mini-window" aria-hidden="true">
            <div class="mini-bar">
              <i></i>
              <i></i>
              <i></i>
              <span>my little corner of the web</span>
            </div>
            <div class="mini-content">
              <span class="mini-word">
                Hello,
                <br />
                world<span>.</span>
              </span>
              <div class="mini-cube"></div>
              <div class="mini-lines">
                <i></i>
                <i></i>
                <i></i>
              </div>
            </div>
            <div class="mini-bottom">
              CREATE. LEARN. REPEAT. <span>↗</span>
            </div>
          </div>
        ) : (
          <div class="note-stack" aria-hidden="true">
            <div class="note-back"></div>
            <div class="note-front">
              <span class="note-date">A LITTLE EVERY DAY</span>
              <span class="note-title">
                작은 기록의
                <br />
                쓸모<span>✳</span>
              </span>
              <div class="note-rule"></div>
              <p>
                생각을 모으다 보면
                <br />
                어느새 나만의 방향이 된다.
              </p>
              <span class="note-no">001 / notes to self</span>
            </div>
          </div>
        )}
      </>
    )}
    {!project.cover && <span class="art-bottom mono">{project.stack.slice(0, 2).join(' + ')}</span>}
  </a>
  <div class="project-info">
    <div class="project-meta">
      <span class="status-dot"></span>
      <span>{project.statusLabel}</span>
      {project.sample && <span class="sample-label">예제 프로젝트</span>}
      <span class="year mono">{project.startedAt}</span>
    </div>
    <a href={project.href}>
      <h3>{project.title}</h3>
    </a>
    <p>{project.summary}</p>
    <div class="tag-list">
      {project.stack.map((s) => (
        <span class="tag">{s}</span>
      ))}
    </div>
  </div>
</article>
<style>
  .project-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .project-art {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    height: 300px;
    border-radius: 8px;
    background: #e9ebe3;
    overflow: hidden;
    border: 1px solid #dfe1d7;
    perspective: 900px;
    color: #32382b;
    transition: border-color var(--dur) var(--ease);
  }
  .project-art:hover,
  .project-art:focus-visible {
    border-color: #b9bfae;
  }
  .project-art.alternate {
    background: #eeebe1;
    border-color: #e4dfd1;
  }
  .art-grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(#929a8110 1px, transparent 1px),
      linear-gradient(90deg, #929a8110 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .art-label,
  .art-bottom {
    position: absolute;
    left: 23px;
    font-size: 9px;
    color: #777e6d;
    letter-spacing: 0.06em;
  }
  .art-label {
    top: 20px;
  }
  .art-bottom {
    bottom: 17px;
  }
  .art-expand {
    position: absolute;
    right: 19px;
    top: 16px;
    display: flex;
  }
  .mini-window {
    background: #f8f9f3;
    width: 68%;
    border: 1px solid #bcc4b4;
    border-radius: 6px;
    transform: rotateY(-12deg) rotateX(9deg) rotateZ(-4deg);
    box-shadow:
      8px 12px 0 #ccd2c3,
      16px 25px 30px #76836b30;
    transition: transform var(--dur-slow) var(--ease);
  }
  .mini-bar {
    display: flex;
    gap: 4px;
    align-items: center;
    border-bottom: 1px solid #dce0d4;
    padding: 9px 11px;
  }
  .mini-bar i {
    width: 4px;
    height: 4px;
    border: 1px solid #adb4a4;
    border-radius: 50%;
  }
  .mini-bar span {
    font: 6px var(--mono);
    margin-left: 8px;
    color: #919884;
  }
  .mini-content {
    padding: 18px 19px 13px;
    position: relative;
  }
  .mini-word {
    font: 700 30px/0.95 var(--sans);
    letter-spacing: -0.06em;
  }
  .mini-word span {
    color: #c95c3c;
  }
  .mini-cube {
    width: 50px;
    height: 55px;
    border-radius: 5px;
    background: linear-gradient(135deg, #cb7350, #a4462d);
    position: absolute;
    right: 27px;
    top: 22px;
    box-shadow:
      5px 6px 0 #e39a75,
      10px 15px 14px #b76b4b35;
    transform: skewY(-12deg);
  }
  .mini-lines {
    margin-top: 18px;
    display: grid;
    gap: 5px;
  }
  .mini-lines i {
    height: 3px;
    background: #e2e5da;
    width: 75%;
  }
  .mini-lines i:nth-child(2) {
    width: 56%;
  }
  .mini-lines i:nth-child(3) {
    width: 68%;
  }
  .mini-bottom {
    margin: 0 18px;
    padding: 9px 0;
    border-top: 1px solid #dce0d4;
    font: 6px var(--mono);
    display: flex;
    justify-content: space-between;
    color: #858d77;
  }
  .note-stack {
    position: relative;
    width: 185px;
    height: 206px;
    margin-top: 8px;
    transform: rotate(-8deg);
    transition: transform var(--dur-slow) var(--ease);
  }
  .note-back {
    position: absolute;
    inset: 0;
    background: #a7b294;
    transform: rotate(13deg) translate(8px, 2px);
    border-radius: 3px;
  }
  .note-front {
    position: absolute;
    inset: 0;
    background: #fffdf3;
    box-shadow: 6px 12px 20px #80765730;
    padding: 20px;
    border-radius: 3px;
  }
  .note-date {
    font: 6px var(--mono);
    color: #9c9681;
    letter-spacing: 0.08em;
  }
  .note-title {
    display: block;
    font-size: 24px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.05em;
    margin-top: 15px;
    position: relative;
  }
  .note-title > span {
    position: absolute;
    right: 0;
    color: #c76841;
    font-size: 34px;
    top: -5px;
  }
  .note-rule {
    border-top: 1px solid #e5e1d1;
    margin: 15px 0 8px;
  }
  .note-front p {
    font-size: 8px;
    line-height: 1.6;
    color: #89836f;
  }
  .note-no {
    display: block;
    margin-top: 13px;
    font: 6px var(--mono);
    color: #a09a87;
  }
  .project-info {
    padding: 18px 1px 0;
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 9px;
  }
  .status-dot {
    width: 5px;
    height: 5px;
    background: #899c72;
    border-radius: 50%;
  }
  .year {
    margin-left: auto;
    font-size: 10px;
  }
  h3 {
    font-size: 22px;
    transition: color var(--dur-fast) var(--ease);
  }
  .project-info a:hover,
  .project-info a:focus-visible {
    color: var(--accent);
  }
  .project-info > p {
    margin: 8px 0 15px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .project-art {
      height: 275px;
    }
    h3 {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .project-art:is(:hover, :focus-visible) .mini-window {
      transform: rotateY(-5deg) rotateX(4deg) rotateZ(-1deg) translateY(-6px);
    }
    :global(:root:not([data-motion='off'])) .project-art:is(:hover, :focus-visible) .note-stack {
      transform: rotate(-3deg) translateY(-6px);
    }
    :global(:root:not([data-motion='off'])) .project-art:is(:hover, :focus-visible) .project-cover {
      transform: scale(1.03);
    }
  }
</style>
