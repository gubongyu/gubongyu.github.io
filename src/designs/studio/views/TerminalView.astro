---
import type { SiteVM } from '../../../application/contracts';
import { path } from '../../../config/site';
import '../styles/theme.css';
import { geometryFrames, artDuration, artFrameDuration } from './terminal-art';
interface Props {
  site: SiteVM;
}
const { site } = Astro.props;
const wordmark = [
  ' ██████╗  █████╗ ██████╗  ██████╗ ███╗   ██╗',
  '██╔════╝ ██╔══██╗██╔══██╗██╔═══██╗████╗  ██║',
  '██║  ███╗╚██████║██████╔╝██║   ██║██╔██╗ ██║',
  '██║   ██║ ╚═══██║██╔══██╗██║   ██║██║╚██╗██║',
  '╚██████╔╝ █████╔╝██████╔╝╚██████╔╝██║ ╚████║',
  ' ╚═════╝  ╚════╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝',
].join('\n');
const data = {
  items: site.index,
  name: site.profile.name,
  bio: site.profile.bio,
  contacts: site.profile.socialLinks,
  email: site.profile.email,
};
---

<div class="terminal-world" data-terminal>
  <header class="terminal-header">
    <a class="terminal-brand" href={path()}>
      {site.profile.name}
      <span>.</span>
      <small> / terminal</small>
    </a>
    <a href={path('search/')} class="search-terminal">
      검색 <kbd>⌘ K</kbd>
    </a>
    <a data-terminal-exit href={path()}>
      일반 페이지로 돌아가기 ↗
    </a>
  </header>
  <main id="main-content">
    <div class="terminal-topbar">
      <div class="window-dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span class="mono">guest@{site.profile.handle} — zsh style</span>
      <span class="terminal-version mono">v0.1.0</span>
    </div>
    <div class="terminal-layout">
      <section class="console">
        <h1 class="sr-only">{site.profile.name} — Interactive portfolio terminal</h1>
        <div class="console-intro" data-terminal-intro>
          <div class="boot-art">
            <pre class="ascii-wordmark" aria-hidden="true">{wordmark}</pre>
            <div class="ascii-scene" style={`--art-duration: ${artDuration}s`}>
              <div class="ascii-geometry" aria-hidden="true">
                {geometryFrames.map((frame, index) => <pre
                  style={`--frame-delay: ${-artDuration + index * artFrameDuration}s`}
                >{frame}</pre>)}
              </div>
              <label class="ascii-motion-control">
                <input type="checkbox" aria-label="ASCII 아트 애니메이션 일시정지" />
                <span>일시정지</span>
              </label>
            </div>
          </div>
          <p class="boot-label">
            <span aria-hidden="true">◆</span> PERSONAL SPACE{' '}
            <span class="boot-label-divider">/</span> CODE · NOTES · IDEAS
          </p>
          <p class="boot-comment"># Welcome to {site.profile.name}'s personal space.</p>
          <p class="boot-command">
            <span class="shell-user">guest@{site.profile.handle}</span>{' '}
            <span class="shell-path">~</span> <span class="prompt-sign">❯</span> help
          </p>
          <p class="boot-comment"># 명령어를 입력하거나 아래 명령을 선택하세요.</p>
          <dl class="command-chips">
            {[
              ['whoami', '프로필 확인'],
              ['blog', '개발 · 일상 기록'],
              ['projects', '프로젝트 목록'],
              ['help', '사용 가능한 명령어'],
            ].map(([command, description]) => (
              <div>
                <dt>
                  <button data-command={command}>{command}</button>
                </dt>
                <dd>{description}</dd>
              </div>
            ))}
          </dl>
          <p class="boot-comment"># Tab: complete · ↑/↓: history · Ctrl+L: clear</p>
        </div>
        <div
          class="terminal-output"
          data-terminal-output
          aria-label="명령 출력"
          role="region"
          tabindex="0"
        ></div>
        <form autocomplete="off">
          <label for="terminal-input">
            <span class="shell-user">guest</span>{' '}
            <span class="shell-path" data-cwd>
              ~
            </span>{' '}
            <span class="prompt-sign">❯</span>
          </label>
          <input
            id="terminal-input"
            data-terminal-input
            aria-label="터미널 명령어"
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
          />
          <button type="submit" aria-label="명령 실행">
            ↵
          </button>
        </form>
        <p class="input-hint">Tab 자동완성 · ↑↓ 기록 · Ctrl+L 지우기 · Esc 나가기 버튼</p>
        <p class="sr-only" data-terminal-status aria-live="polite"></p>
      </section>
      <aside class="preview" data-terminal-preview aria-label="콘텐츠 미리보기">
        <p class="eyebrow">THE READING ROOM</p>
        <div class="preview-decoration" aria-hidden="true">
          [ <span>↗</span> ]
        </div>
        <h2>기록을 열어 보세요.</h2>
        <p>
          <code>ls</code>로 둘러보고 <code>cat</code>으로 열어 보세요.
          <br />
          글과 프로젝트의 미리보기가 여기에 나타납니다.
        </p>
        <a href={path('blog/')} class="preview-link">
          모든 글 둘러보기 ↗
        </a>
      </aside>
    </div>
    <div class="terminal-statusbar">
      <span>[ {site.profile.handle} ]</span>
      <span>0: explorer*</span>
      <span data-cwd>~</span>
      <a data-terminal-exit href={path()}>
        WEB MODE →
      </a>
    </div>
  </main>
  <footer>
    가상 터미널입니다. 공개된 글과 프로젝트만 탐색합니다.
    {site.profile.sample && <span> · 예제 콘텐츠</span>}
  </footer>
  <noscript>
    <p>
      터미널에는 JavaScript가 필요합니다. <a href={path('blog/')}>글 목록으로 이동</a>
    </p>
  </noscript>
  <script
    type="application/json"
    data-terminal-data
    set:html={JSON.stringify(data).replaceAll('<', '\u003c')}
  />
</div>
<script>
  import { mountTerminal } from '../../../features/terminal';
  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach(mountTerminal);
</script>
<style>
  :global(html[data-experience='terminal']) {
    --bg: #14161c;
    --surface: #1c1f28;
    --ink: #e0e4ef;
    --muted: #9ba4b8;
    --line: #303647;
    --accent: #e5c07b;
    --soft: #242936;
    color-scheme: dark;
  }
  .terminal-world {
    width: calc(100% - 40px);
    max-width: 1920px;
    margin: 0 auto;
    font-family: var(--mono);
  }
  .terminal-header {
    height: 68px;
    display: flex;
    align-items: center;
    gap: 25px;
    font: 11px var(--sans);
  }
  .terminal-brand {
    font: 700 22px var(--sans);
    letter-spacing: -0.05em;
  }
  .terminal-brand > span {
    color: var(--accent);
  }
  .terminal-brand small {
    font: 10px var(--mono);
    color: var(--muted);
    letter-spacing: 0;
  }
  .search-terminal {
    margin-left: auto;
  }
  kbd {
    border: 1px solid var(--line);
    padding: 4px;
    color: var(--muted);
    margin-left: 5px;
  }
  main {
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .terminal-topbar {
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    background: #1c1f28;
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 9px;
    color: var(--muted);
  }
  .terminal-version {
    margin-left: auto;
  }
  .window-dots {
    display: flex;
    gap: 6px;
  }
  .window-dots i {
    width: 7px;
    height: 7px;
    background: #61c454;
    border-radius: 50%;
  }
  .window-dots i:first-child {
    background: #ff605c;
  }
  .terminal-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
    min-height: max(720px, calc(100dvh - 160px));
  }
  .console {
    padding: 32px;
    min-width: 0;
    border-right: 1px solid var(--line);
  }
  .console-intro {
    font: 14px/1.9 var(--mono);
    margin-bottom: 28px;
    overflow-wrap: anywhere;
  }
  .console-intro {
    container-type: inline-size;
  }
  .boot-art {
    display: grid;
    justify-items: start;
    gap: 24px;
    margin: 4px 0 20px;
  }
  .boot-art pre {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    font-size: clamp(8px, 2.9cqw, 16px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: pre;
    overflow-wrap: normal;
    margin: 0;
  }
  .ascii-wordmark {
    color: #98c379;
  }
  .ascii-scene {
    width: 100%;
    padding: 20px 0 8px;
    border-block: 1px solid var(--line);
    background: radial-gradient(ellipse at center, #56b6c20c, transparent 70%);
    display: grid;
    justify-items: center;
    gap: 8px;
  }
  .ascii-geometry {
    display: grid;
    color: #56b6c2;
  }
  .boot-art .ascii-geometry pre {
    grid-area: 1 / 1;
    font-size: clamp(4px, 1.9cqw, 14px);
    line-height: 1.15;
    font-weight: 400;
    opacity: 0;
    animation: sculpture-turn var(--art-duration) steps(1, end) infinite;
    animation-delay: var(--frame-delay);
  }
  .ascii-motion-control {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    color: var(--muted);
    font-size: 10px;
    cursor: pointer;
  }
  .ascii-motion-control input {
    accent-color: #56b6c2;
  }
  .ascii-scene:has(input:checked) pre {
    animation-play-state: paused;
  }
  @keyframes sculpture-turn {
    0% {
      opacity: 1;
    }
    2.0833333333%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .boot-art .ascii-geometry pre {
      animation: none;
    }
    .boot-art .ascii-geometry pre:first-child {
      opacity: 1;
    }
    .ascii-motion-control {
      display: none;
    }
  }
  .boot-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .boot-label > span {
    color: var(--accent);
  }
  .boot-label-divider {
    margin: 0 6px;
  }
  .boot-comment {
    color: var(--muted);
    margin: 0;
  }
  .boot-command {
    margin: 24px 0 8px;
  }
  .shell-user,
  .terminal-output :global(.shell-user) {
    color: #98c379;
  }
  .shell-path,
  .terminal-output :global(.shell-path) {
    color: #61afef;
  }
  .command-chips {
    margin: 12px 0 18px;
  }
  .command-chips > div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    align-items: center;
  }
  .command-chips dd {
    margin: 0;
    color: var(--muted);
  }
  .command-chips button {
    background: transparent;
    color: #56b6c2;
    padding: 8px 0;
    font: inherit;
    min-height: 44px;
    text-align: left;
  }
  .command-chips button:hover {
    color: #98c379;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .window-dots i:nth-child(2) {
    background: #ffbd44;
  }
  .terminal-output {
    max-height: max(360px, calc(100dvh - 560px));
    overflow-y: auto;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 18px;
    scrollbar-color: #465169 transparent;
  }
  .terminal-output :global(p),
  .terminal-output :global(button),
  .terminal-output :global(a) {
    display: block;
    text-align: left;
    background: transparent;
    font: inherit;
    color: inherit;
    padding: 2px 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .terminal-output :global(.command-echo) {
    color: var(--ink);
    margin-top: 16px;
  }
  .terminal-output :global(button),
  .terminal-output :global(a) {
    color: #61afef;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .terminal-output :global(.dim) {
    color: var(--muted);
  }
  form {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    font-size: 14px;
  }
  form label {
    white-space: nowrap;
    color: var(--muted);
  }
  .prompt-sign,
  .terminal-output :global(.prompt-sign) {
    color: var(--accent);
  }
  form input {
    background: transparent;
    border: none;
    min-width: 0;
    width: 100%;
    color: var(--ink);
    outline-offset: 2px;
  }
  form button {
    background: var(--soft);
    color: var(--accent);
    min-width: 40px;
    min-height: 40px;
    border-radius: 3px;
  }
  .input-hint {
    font: 9px/1.8 var(--sans);
    color: #9ba4b8;
    margin-top: 12px;
  }
  .preview {
    padding: 36px;
    align-self: start;
  }
  .preview .eyebrow {
    font-size: 9px;
  }
  .preview-decoration {
    font-size: 52px;
    text-align: center;
    margin: 70px 0;
    color: #303647;
  }
  .preview-decoration span {
    color: #56b6c2;
  }
  .preview :global(h2) {
    font: 600 23px/1.6 var(--sans);
    margin: 30px 0 18px;
  }
  .preview :global(p:not(.eyebrow)) {
    font: 12px/2 var(--sans);
    color: var(--muted);
  }
  .preview :global(.preview-link) {
    display: inline-block;
    font: 11px var(--sans);
    margin-top: 30px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
  }
  .preview :global(.preview-tags) {
    margin-top: 20px;
  }
  .terminal-statusbar {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 0 15px 0 0;
    background: #242936;
    color: #abb2bf;
    font-size: 9px;
    min-height: 30px;
  }
  .terminal-statusbar > span:first-child {
    padding: 8px 16px;
    background: #365b46;
  }
  .terminal-statusbar a {
    margin-left: auto;
    font-size: 8px;
    min-height: 30px;
    display: flex;
    align-items: center;
  }
  footer {
    padding: 18px 0;
    font: 10px var(--sans);
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .console-intro,
    .terminal-output,
    form {
      font-size: 13px;
    }
    .terminal-world {
      width: calc(100% - 20px);
    }
    .terminal-layout {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .console {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 24px 18px;
    }
    .preview {
      padding: 25px 18px;
    }
    .preview-decoration {
      display: none;
    }
    .terminal-header {
      gap: 14px;
      height: 80px;
    }
    .terminal-brand small,
    .search-terminal {
      display: none;
    }
    .terminal-header > a:last-child {
      margin-left: auto;
      font-size: 10px;
    }
    .console-intro h1 {
      font-size: 13px;
    }
    .terminal-topbar {
      gap: 10px;
    }
    .terminal-topbar > .mono {
      font-size: 8px;
    }
  }
</style>
