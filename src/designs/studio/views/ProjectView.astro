---
import type { SiteVM, ProjectVM } from '../../../application/contracts';
import { path } from '../../../config/site';
import ArticleFrame from '../components/ArticleFrame.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectPipeline from '../components/ProjectPipeline.astro';
interface Props {
  site: SiteVM;
  project: ProjectVM;
  headings: { depth: number; slug: string; text: string }[];
  stages?: {
    id: string;
    title: string;
    description: string;
    image: string;
    relatedPostHref?: string;
  }[];
}
const { site, project, headings, stages = [] } = Astro.props;
const posts = site.posts.filter((p) => project.relatedPosts.includes(p.id));
---

<ArticleFrame
  profile={site.profile}
  title={project.title}
  summary={project.summary}
  headings={headings}
  backHref={path('projects/')}
  backLabel="모든 프로젝트"
>
  {project.interactive === 'met-a-round-pipeline' && (
    <ProjectPipeline slot="wide" stages={stages} />
  )}
  <Fragment slot="meta">
    PROJECT / {project.statusLabel} / {project.startedAt}{' '}
    {project.sample && <span class="sample-label">예제 프로젝트</span>}
  </Fragment>
  <div slot="tags" class="tag-list">
    {project.tagLinks.map((tag) => (
      <a class="tag" href={tag.href} data-pagefind-filter="tag">
        {tag.label}
      </a>
    ))}
  </div>
  <div class="project-facts">
    <div>
      <span>ROLE</span>
      <p>{project.role}</p>
    </div>
    <div>
      <span>STATUS</span>
      <p>{project.statusLabel}</p>
    </div>
    {project.stack.length > 0 && (
      <div>
        <span>STACK</span>
        <p>{project.stack.join(' · ')}</p>
      </div>
    )}
  </div>
  {(project.repositoryUrl || project.demoUrl) && (
    <div class="project-links">
      {project.repositoryUrl && (
        <a
          class="button secondary"
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          저장소
          <Icon
            name={/github\.com/i.test(project.repositoryUrl) ? 'github' : 'external-link'}
            size={15}
          />
        </a>
      )}
      {project.demoUrl && (
        <a class="button" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
          라이브 데모 <Icon name="external-link" size={15} />
        </a>
      )}
    </div>
  )}
  <slot />
  <Fragment slot="after">
    {posts.length > 0 && (
      <section>
        <h2 style="font-size:22px;margin-bottom:24px">이 프로젝트의 기록</h2>
        <PostList posts={posts} />
      </section>
    )}
  </Fragment>
</ArticleFrame>
<style>
  .project-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 60px;
    background: var(--soft);
    padding: 22px;
    margin-bottom: 35px;
    border-radius: 6px;
  }
  .project-facts span {
    font: 9px var(--mono);
    color: var(--muted);
  }
  .project-facts p {
    font-size: 13px;
    margin-top: 7px;
  }
  .project-links {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
  }
</style>
