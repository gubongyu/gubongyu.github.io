---
import { getSite } from '../server/public-content';
import { NotFoundView } from '../presentation/active-design';
import SiteDocument from '../presentation/SiteDocument.astro';
const site = await getSite();
---

<SiteDocument
  name={site.profile.name}
  seo={{ title: '페이지를 찾을 수 없습니다', description: '홈이나 검색에서 기록을 찾아보세요.' }}
>
  <NotFoundView site={site} />
</SiteDocument>
